<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.example.studentmanager.controller.StudentFormController"
            styleClass="root-pane">
   
   <!-- Header Section -->
   <top>
      <VBox styleClass="header-section">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Label fx:id="formTitleLabel" styleClass="title-label" text="Add New Student" />
                  <Label styleClass="subtitle-label" text="Complete all required fields marked with *" />
               </children>
            </HBox>
            <Separator styleClass="header-separator" />
         </children>
         <padding>
            <Insets bottom="15.0" left="25.0" right="25.0" top="20.0" />
         </padding>
      </VBox>
   </top>
   
   <!-- Main Form Content -->
   <center>
      <ScrollPane fitToWidth="true" styleClass="form-scroll-pane" hbarPolicy="NEVER">
         <content>
            <VBox spacing="20.0" styleClass="form-container">
               <children>
                  
                  <!-- Personal Information Section -->
                  <VBox spacing="12.0" styleClass="form-section">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label styleClass="section-icon" text="👤" />
                              <Label styleClass="section-title" text="Personal Information" />
                           </children>
                        </HBox>
                        
                        <GridPane hgap="20.0" vgap="15.0" styleClass="form-grid">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
                           </columnConstraints>
                           
                           <children>
                              <!-- First Name -->
                              <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                 <children>
                                    <Label styleClass="field-label" text="First Name *" />
                                    <TextField fx:id="firstNameField" 
                                             promptText="Enter first name" 
                                             styleClass="form-field" />
                                    <Label fx:id="firstNameErrorLabel" 
                                          styleClass="error-label" 
                                          managed="false" 
                                          visible="false" />
                                 </children>
                              </VBox>
                              
                              <!-- Last Name -->
                              <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                 <children>
                                    <Label styleClass="field-label" text="Last Name *" />
                                    <TextField fx:id="lastNameField" 
                                             promptText="Enter last name" 
                                             styleClass="form-field" />
                                    <Label fx:id="lastNameErrorLabel" 
                                          styleClass="error-label" 
                                          managed="false" 
                                          visible="false" />
                                 </children>
                              </VBox>
                              
                              <!-- Email -->
                              <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                 <children>
                                    <Label styleClass="field-label" text="Email Address *" />
                                    <TextField fx:id="emailField" 
                                             promptText="student@university.edu" 
                                             styleClass="form-field" />
                                    <Label fx:id="emailErrorLabel" 
                                          styleClass="error-label" 
                                          managed="false" 
                                          visible="false" />
                                 </children>
                              </VBox>
                              
                              <!-- Phone -->
                              <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                 <children>
                                    <Label styleClass="field-label" text="Phone Number" />
                                    <TextField fx:id="phoneField" 
                                             promptText="+1 (234) 567-8900" 
                                             styleClass="form-field" />
                                    <Label fx:id="phoneErrorLabel" 
                                          styleClass="error-label" 
                                          managed="false" 
                                          visible="false" />
                                 </children>
                              </VBox>
                              
                              <!-- Age -->
                              <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                 <children>
                                    <Label styleClass="field-label" text="Age *" />
                                    <Spinner fx:id="ageSpinner" 
                                           editable="true" 
                                           styleClass="form-field"
                                           prefWidth="200.0" />
                                    <Label fx:id="ageErrorLabel" 
                                          styleClass="error-label" 
                                          managed="false" 
                                          visible="false" />
                                 </children>
                              </VBox>
                              
                              <!-- Enrollment Date -->
                              <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                 <children>
                                    <Label styleClass="field-label" text="Enrollment Date *" />
                                    <DatePicker fx:id="enrollmentDatePicker" 
                                              promptText="Select date" 
                                              styleClass="form-field"
                                              prefWidth="200.0" />
                                    <Label fx:id="enrollmentDateErrorLabel" 
                                          styleClass="error-label" 
                                          managed="false" 
                                          visible="false" />
                                 </children>
                              </VBox>
                           </children>
                        </GridPane>
                     </children>
                  </VBox>
                  
                  <!-- Academic Information Section -->
                  <VBox spacing="12.0" styleClass="form-section">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label styleClass="section-icon" text="🎓" />
                              <Label styleClass="section-title" text="Academic Information" />
                           </children>
                        </HBox>
                        
                        <GridPane hgap="20.0" vgap="15.0" styleClass="form-grid">
                           <columnConstraints>
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
                              <ColumnConstraints hgrow="SOMETIMES" percentWidth="50.0" />
                           </columnConstraints>
                           
                           <children>
                              <!-- Major -->
                              <VBox spacing="6.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                 <children>
                                    <Label styleClass="field-label" text="Major *" />
                                    <ComboBox fx:id="majorComboBox" 
                                            editable="true" 
                                            promptText="Select or enter major" 
                                            styleClass="form-field"
                                            maxWidth="Infinity" />
                                    <Label fx:id="majorErrorLabel" 
                                          styleClass="error-label" 
                                          managed="false" 
                                          visible="false" />
                                 </children>
                              </VBox>
                              
                              <!-- GPA -->
                              <VBox spacing="6.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                 <children>
                                    <Label styleClass="field-label" text="GPA (0.0 - 4.0) *" />
                                    <Spinner fx:id="gpaSpinner" 
                                           editable="true" 
                                           styleClass="form-field"
                                           prefWidth="200.0" />
                                    <Label fx:id="gpaErrorLabel" 
                                          styleClass="error-label" 
                                          managed="false" 
                                          visible="false" />
                                 </children>
                              </VBox>
                              
                              <!-- Academic Status Display -->
                              <VBox spacing="6.0" 
                                   styleClass="status-box"
                                   GridPane.columnIndex="0" 
                                   GridPane.columnSpan="2" 
                                   GridPane.rowIndex="1">
                                 <children>
                                    <Label styleClass="field-label" text="Academic Status" />
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Label fx:id="academicStatusLabel" 
                                                styleClass="status-label" 
                                                text="Calculated automatically based on GPA" />
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </GridPane>
                     </children>
                  </VBox>
                  
                  <!-- Validation Summary Panel -->
                  <VBox fx:id="validationSummary" 
                       spacing="10.0" 
                       styleClass="validation-panel" 
                       managed="false"
                       visible="false">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <Label styleClass="validation-icon" text="⚠️" />
                              <Label styleClass="validation-title" text="Please correct the following errors:" />
                           </children>
                        </HBox>
                        <TextArea fx:id="validationTextArea" 
                                editable="false" 
                                wrapText="true"
                                prefRowCount="4" 
                                styleClass="validation-text" />
                     </children>
                     <padding>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </padding>
                  </VBox>
                  
               </children>
               <padding>
                  <Insets bottom="25.0" left="25.0" right="25.0" top="10.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   
   <!-- Action Buttons Footer -->
   <bottom>
      <VBox styleClass="footer-section">
         <children>
            <Separator styleClass="footer-separator" />
            <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="button-bar">
               <children>
                  <Button fx:id="resetButton" 
                         onAction="#handleReset" 
                         styleClass="secondary-button" 
                         text="Reset Form" />
                  <Button fx:id="cancelButton" 
                         onAction="#handleCancel" 
                         styleClass="secondary-button" 
                         text="Cancel" />
                  <Button fx:id="saveButton" 
                         onAction="#handleSave" 
                         styleClass="primary-button" 
                         text="Save Student"
                         defaultButton="true" />
               </children>
               <padding>
                  <Insets bottom="20.0" left="25.0" right="25.0" top="15.0" />
               </padding>
            </HBox>
         </children>
      </VBox>
   </bottom>
   
</BorderPane>