<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.StudentController">
   <top>
      <Label text="JavaFX MVVM User Management Example" BorderPane.alignment="CENTER">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
         <BorderPane.margin>
            <Insets bottom="10.0" top="10.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <center>
      <VBox prefHeight="452.0" prefWidth="522.0" spacing="10.0">
         <children>
            <!-- Student Input Form -->
            <VBox spacing="5.0" style="-fx-border-color: lightgray; -fx-border-radius: 5; -fx-padding: 10;">
               <children>
                  <Label text="User Information">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  
                  <!-- First Name Input -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label minWidth="80.0" text="First Name:" />
                        <TextField fx:id="firstNameField" promptText="Enter first name" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  
                  <!-- Last Name Input -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label minWidth="80.0" text="Last Name:" />
                        <TextField fx:id="lastNameField" promptText="Enter last name" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <!-- Email Input -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label minWidth="80.0" text="Email:" />
                        <TextField fx:id="emailField" promptText="Enter email" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>

                  <!-- Birthdate Input -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label minWidth="80.0" text="Birth Date:" />
                        <DatePicker fx:id="birthDateField" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
                  
                  <!-- Action Buttons -->
                  <HBox spacing="10.0">
                     <children>
                        <Button fx:id="saveButton" onAction="#handleSaveStudent" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Save User" />
                        <Button fx:id="clearButton" onAction="#handleClearForm" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Clear Form" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <!-- Student List Display -->
            <VBox spacing="5.0" style="-fx-border-color: lightgray; -fx-border-radius: 5; -fx-padding: 10;" VBox.vgrow="ALWAYS">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="User List">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="studentCountLabel" style="-fx-text-fill: gray;" text="Total Users: 0" />
                     </children>
                  </HBox>

                  <!-- Search and Sort Controls -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                      <children>
                          <TextField fx:id="searchField" promptText="Search..." HBox.hgrow="ALWAYS" />
                          <ComboBox fx:id="sortByComboBox" prefWidth="150.0" promptText="Sort by" />
                          <CheckBox fx:id="sortAscendingCheckBox" mnemonicParsing="false" prefHeight="18.0" prefWidth="98.0" text="Ascending" />
                      </children>
                  </HBox>
                  
                  <!-- Students ListView -->
                  <ListView fx:id="studentListView" prefHeight="126.0" prefWidth="347.0" VBox.vgrow="ALWAYS" />
                  
                  <!-- List Actions -->
                  <HBox spacing="10.0">
                     <children>
                        <Button fx:id="deleteButton" onAction="#handleDeleteStudent" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Delete Selected" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <Label prefHeight="43.0" prefWidth="290.0" style="-fx-text-fill: gray; -fx-font-size: 10;" text="MVVM Pattern: Model-View-ViewModel with JavaFX Data Binding" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets top="10.0" />
         </BorderPane.margin>
      </Label>
   </bottom>
</BorderPane>
